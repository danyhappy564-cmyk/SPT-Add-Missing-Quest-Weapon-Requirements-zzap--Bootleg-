<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SptDbExporter</RootNamespace>
    <AssemblyName>SptDbExporter</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <Version>1.0.0</Version>
    <OutputPath>bin\$(Configuration)\$(ProjectName)\$(AssemblyName)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SPTushonka.Common" Version="4.1.5" />
    <PackageReference Include="SPTushonka.DI" Version="4.1.5" />
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.5" />
  </ItemGroup>

  <!--
    Deploy to SPT mods folder after build.
    Requires local.props with <SptRoot> set (copy local.props.template → local.props).
    Generates exporter-config.json pointing OutputPath to SptDbExporter/export/ under this project.
  -->
  <!--
    Opt-in only. This is a developer tool: it dumps the whole item/quest/locale database
    to disk so the Inspector and the integration tests have an offline slice to work
    against. A player has no use for it, and left installed it warns on every server boot
    about the missing exporter-config.json. Deploy it deliberately:

      dotnet build SptDbExporter/SptDbExporter.csproj -c Release -p:DeployExporter=true
  -->
  <Target Name="DeployToSptMods" AfterTargets="Build"
          Condition="'$(DeployExporter)' == 'true' and '$(SptModsDir)' != '' and '$(SptRoot)' != 'CHANGE_ME' and Exists('$(SptModsDir)')">
    <PropertyGroup>
      <_DeployDir>$(SptModsDir)\SptDbExporter</_DeployDir>
      <!-- Forward slashes avoid JSON backslash escaping -->
      <_ExportDir>$(MSBuildProjectDirectory.Replace('\', '/'))/export</_ExportDir>
      <_ConfigJson>{"OutputPath": "$(_ExportDir)"}</_ConfigJson>
    </PropertyGroup>

    <MakeDir Directories="$(_DeployDir)" />
    <MakeDir Directories="$(MSBuildProjectDirectory)\export" />

    <ItemGroup>
      <_DeployFiles Include="$(TargetDir)*.dll" />
      <_DeployFiles Include="$(TargetDir)*.pdb" />
      <_DeployFiles Include="$(TargetDir)*.deps.json" />
      <_DeployFiles Include="$(TargetDir)*.staticwebassets.endpoints.json" />
    </ItemGroup>

    <Copy SourceFiles="@(_DeployFiles)" DestinationFolder="$(_DeployDir)" SkipUnchangedFiles="true" />

    <WriteLinesToFile File="$(_DeployDir)\exporter-config.json"
                      Lines="$(_ConfigJson)"
                      Overwrite="true" />

    <Message Text="[SptDbExporter] Deployed → $(_DeployDir)" Importance="high" />
  </Target>

  <!--
    Rule 2-2: every Release build also drops a ready-to-ship archive in release/.
    Skip with -p:SkipPackage=true.
  -->
  <Target Name="PackageRelease" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' AND '$(SkipPackage)' != 'true'">
    <PropertyGroup>
      <PackageStageDir>$(IntermediateOutputPath)package\</PackageStageDir>
      <PackageZipDir>$(MSBuildThisFileDirectory)release\</PackageZipDir>
      <PackageZipPath>$(PackageZipDir)$(AssemblyName)-$(Version).zip</PackageZipPath>
    </PropertyGroup>
    <ItemGroup>
      <PackageFiles Include="$(OutputPath)**\*" Exclude="$(OutputPath)**\*.pdb;$(OutputPath)**\*.deps.json" />
    </ItemGroup>
    <RemoveDir Directories="$(PackageStageDir)" />
    <Copy SourceFiles="@(PackageFiles)"
          DestinationFiles="@(PackageFiles->'$(PackageStageDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    <MakeDir Directories="$(PackageZipDir)" />
    <Delete Files="$(PackageZipPath)" />
    <ZipDirectory SourceDirectory="$(PackageStageDir)" DestinationFile="$(PackageZipPath)" Overwrite="true" />
    <Message Text="Packaged $(PackageZipPath)" Importance="high" />
  </Target>

</Project>
